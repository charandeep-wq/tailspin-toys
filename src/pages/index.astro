---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <div class="grid gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Filter by category</legend>
                <div class="grid gap-2 sm:grid-cols-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Filter by publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap items-center gap-4">
              <button
                type="reset"
                data-testid="clear-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                Clear filters
              </button>
              <p id="filter-status" role="status" aria-live="polite" class="text-sm text-slate-400" data-testid="filter-status">
                Showing {games.length} games
              </p>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  const applyFilters = (): void => {
    if (!filterForm) return;

    const selectedCategories = new Set(
      Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
        .map((input) => input.value),
    );
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    if (status) status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
  };

  filterForm?.addEventListener('input', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
